# Copy to .env (Windows: Copy-Item .env.example .env) and fill in. Never commit .env.

# --- Required for AI features (NVIDIA NIM, OpenAI-compatible) -----------------
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1/chat/completions
STUDYAI_GEN_MODEL=openai/gpt-oss-120b
STUDYAI_FALLBACK_MODELS=stepfun-ai/step-3.7-flash,meta/llama-3.3-70b-instruct
STUDYAI_AI_TIMEOUT_SECONDS=45
STUDYAI_AI_RETRIES=0
STUDYAI_AI_BUDGET_SECONDS=52

# --- Required in production (Vercel): long random string ----------------------
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database ------------------------------------------------------------------
# Leave DATABASE_URL empty locally to use SQLite (studyai.db). Set it to use PostgreSQL:
#   postgresql://studyai:studyai@localhost:5432/studyai          (local / Docker)
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require           (Neon)
DATABASE_URL=

# --- Optional ------------------------------------------------------------------
# SQLITE_PATH=studyai.db
# MAX_UPLOAD_MB=20          (default is 4 on Vercel: its request limit is ~4.5 MB)
# STUDYAI_DEBUG=0
# PORT=5001
